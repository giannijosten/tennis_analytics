# --- Python & Cache ---
# Diese Dateien erstellt Python automatisch beim Ausführen - Ballast für das Repo.
__pycache__/
*.py[cod]

# --- Scrapy & Logs ---
# Scrapy schreibt Log-Dateien, wenn Fehler auftreten - nicht im Repo speichern.
*.log

# --- Daten ---
# Ignoriere den kompletten processed-Ordner (Verarbeitete Daten bleiben lokal auf dem Mac)
data/processed/*

# --- Environments ---
# Abfangen von Umgebungen. 
.venv/
venv/
.conda/
env/

# --- System-Müll ---
# Dateien, die Windows oder macOS ungefragt in Ordnern erstellen.
.DS_Store
Thumbs.db

# --- Lokale VS-Code-Einstellungen ---
.vscode/settings.json