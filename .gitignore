# --- Python & Cache ---
# Diese Dateien erstellt Python automatisch beim Ausführen - Ballast für das Repo.
__pycache__/
*.py[cod]

# --- Scrapy & Logs ---
# Scrapy schreibt Log-Dateien, wenn Fehler auftreten - nicht im Repo speichern.
*.log

# --- Daten ---
# Verarbeitete Daten werden ignoriert - Analyseergebnisse verbleiben nur lokal auf dem Mac.
data/**/*

# Ausnahme für Rohdaten - Ermöglicht das Tracking der min. 30-tägigen Zeitreihendaten via GitHub Actions.
!data/raw/*.csv

# Ausnahme für Strukturerhalt - Die leeren Ordner bleiben über .gitkeep sichtbar.
!data/**/.gitkeep

# --- Environments ---
# Abfangen von Umgebungen. 
.venv/
venv/
.conda/
env/

# --- System-Müll ---
# Dateien, die Windows oder macOS ungefragt in Ordnern erstellen.
.DS_Store
Thumbs.db